#!/usr/bin/env bash

cd tests

# Create a new virtual environment
pyenv virtualenv test_install

# Create a new subdirectory
mkdir .test_install

# Go and set local environment
cd .test_install
pyenv local test_install

# Install the project
pip install git+https://github.com/dam024/LabTools.git

# Initialize the project
labtools init -d 'Test description'

# Run the tests
python main.py test

# Run the checks
python main.py check


#### Clean up
cd ..
rm -rf .test_install
pyenv virtualenv-delete -f test_install